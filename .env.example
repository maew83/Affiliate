# คีย์ Claude API (สร้างได้ที่ https://console.anthropic.com)
# ไม่ใส่ก็ได้: แอปยังทำเสียงและวิดีโอได้ แต่ต้องเขียนแคปชันและสคริปต์เอง
ANTHROPIC_API_KEY=sk-ant-...

# เสียงพากย์ Edge TTS: th-TH-PremwadeeNeural (หญิง) หรือ th-TH-NiwatNeural (ชาย)
TTS_VOICE=th-TH-PremwadeeNeural

# ฟอนต์ที่ใช้ทำซับในวิดีโอ (ต้องเป็นฟอนต์ที่รองรับภาษาไทยและติดตั้งในเครื่อง)
SUBTITLE_FONT=Tahoma
